# ============================================
# 群像·星火 环境变量示例
# ============================================
# 使用方法：复制此文件为 .env，填入真实值
# 警告：.env 文件包含敏感信息，严禁提交到 Git 仓库
# cp .env.example .env
# ============================================

# ===== 数据库 =====
# SQLite 数据库文件路径
DATABASE_URL="file:./prisma/dev.db"

# ===== NextAuth 认证 =====
# JWT 加密密钥（必填！使用强随机字符串）
# 生成方法：openssl rand -base64 32
AUTH_SECRET="请替换为随机生成的密钥"

# 认证回调 URL（生产环境为正式域名）
NEXTAUTH_URL="https://www.qunxiangxinghuo.cn"

# ===== 管理员配置 =====
# 管理员邮箱白名单（逗号分隔），用于访问 /api/reports 等管理接口
ADMIN_EMAILS="admin@example.com"

# ===== AI 模型（豆包） =====
# Coze 平台 API 密钥
COZE_API_KEY=""

# ===== 知乎开放平台（可选） =====
ZHIHU_API_KEY=""
ZHIHU_API_SECRET=""

# ===== 运行环境 =====
# development | production
NODE_ENV="production"
