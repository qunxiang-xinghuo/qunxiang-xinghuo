# 数据库配置
DATABASE_URL="file:./dev.db"

# NextAuth 配置
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here-change-in-production"

# 应用配置
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# 开发配置
NODE_ENV="development"

# AI 服务配置 (Phase 4)
# OPENAI_API_KEY="your-openai-api-key"
# ANTHROPIC_API_KEY="your-anthropic-api-key"
# GOOGLE_AI_API_KEY="your-google-ai-api-key"

# 文件上传配置 (Phase 4)
# UPLOADTHING_SECRET="your-uploadthing-secret"
# UPLOADTHING_APP_ID="your-uploadthing-app-id"

# 邮件服务配置 (Phase 4)
# EMAIL_SERVER="smtp.gmail.com:587"
# EMAIL_USER="your-email@gmail.com"
# EMAIL_PASSWORD="your-email-password"

# 监控配置 (Phase 4)
# SENTRY_DSN="your-sentry-dsn"
# LOGTAIL_SOURCE_TOKEN="your-logtail-source-token"

# 后台管理员配置（种子数据初始化用）
BACKEND_ADMIN="xingxing"
BACKEND_ADMIN_PAASSWORD="xingxing123"

# 知乎圈子开放平台配置（发帖/评论/点赞）
# ZHIHU_RING_APP_KEY="your-zhihu-user-token"
# ZHIHU_RING_APP_SECRET="your-zhihu-app-secret"
# 获取方式：打开知乎个人主页 → 右上角「...」→ 复制链接 → people/后面就是 token

# 知乎开发者平台配置（搜索/热榜/直答）
# ZHIHU_API_KEY="your-zhihu-access-secret"

# 知乎 OAuth 登录配置
# ZHIHU_APP_ID="your-zhihu-oauth-app-id"
# ZHIHU_APP_KEY="your-zhihu-oauth-app-key"
# 申请地址：https://open.zhihu.com/ → 创建应用 → 获取 APP_ID 和 APP_KEY
# 回调地址：${NEXTAUTH_URL}/api/auth/callback/zhihu