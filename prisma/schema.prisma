// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  conversations Conversation[]
  stories       Story[]
  
  // Sessions
  sessions      Session[]

  @@index([email])
  @@index([username])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Scene {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  location    String
  tags        String   // JSON array as string
  prompt      String
  createdAt   DateTime @default(now())
  
  // Relations
  roles         Role[]
  conversations Conversation[]
}

model Role {
  id          String   @id @default(cuid())
  sceneId     String
  name        String
  description String
  color       String
  personality String
  createdAt   DateTime @default(now())
  
  // Relations
  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  
  // Conversation participants
  conversations ConversationRole[]
}

model Conversation {
  id          String    @id @default(cuid())
  sceneId     String
  userId      String
  status      String    @default("active") // active, completed, archived
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  scene   Scene              @relation(fields: [sceneId], references: [id])
  user    User               @relation(fields: [userId], references: [id])
  roles   ConversationRole[]
  messages Message[]
  story   Story?

  @@index([userId])
  @@index([sceneId])
  @@index([status])
  @@index([createdAt])
}

model ConversationRole {
  id             String @id @default(cuid())
  conversationId String
  roleId         String
  userId         String?
  isAI           Boolean @default(false)
  
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  roleId         String
  content        String
  type           String   @default("dialogue") // dialogue, thought, narration
  isHighlight    Boolean  @default(false)
  createdAt      DateTime @default(now())
  
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([roleId])
  @@index([createdAt])
}

model Story {
  id             String   @id @default(cuid())
  conversationId String   @unique
  userId         String
  title          String
  content        String   // Markdown content
  summary        String
  status         String   @default("draft") // draft, published
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([conversationId])
  @@index([createdAt])
  @@index([status])
}

// 知乎数据采集存储
model ZhihuContent {
  id          String   @id @default(cuid())
  type        String   // scene, character, emotion, story
  query       String   // 搜索关键词
  title       String
  content     String
  summary     String   // AI 生成的摘要
  sourceUrl   String?
  tags        String   // JSON array as string
  createdAt   DateTime @default(now())
  
  @@index([type])
  @@index([query])
}

// AI 生成记录
model AIGeneration {
  id          String   @id @default(cuid())
  type        String   // scene, character, secret, story_polish
  prompt      String   // 输入提示
  result      String   // 生成结果
  context     String?  // 使用的知乎上下文
  userId      String?
  createdAt   DateTime @default(now())
  
  @@index([type])
}

// 双人创作房间（无需登录）
model Room {
  id              String   @id // 6 位房间号 (ABC123)
  scene           String   // 场景描述 (最多 200 字)
  roleAName       String   // 角色 A 名字 (最多 20 字)
  roleBName       String   // 角色 B 名字 (最多 20 字)
  roleADescription String? // 角色 A 描述
  roleBDescription String? // 角色 B 描述
  
  // 状态控制
  status          String   @default("waiting") // waiting, active, completed, expired
  currentRound    Int      @default(0)         // 当前轮次 (0-10)
  currentRole     String   @default("A")       // 当前轮到谁 (A/B)
  hostId          String   // 创建者匿名 ID
  guestId         String?  // 加入者匿名 ID
  
  // 时间控制
  createdAt       DateTime @default(now())
  expiresAt       DateTime // 过期时间（24 小时后）
  lastActiveAt    DateTime @default(now())
  
  // 配额管理
  zhihuCallsUsed  Int      @default(0)  // 知乎 API 已用次数
  zhihuCallsMax   Int      @default(100) // 知乎 API 最大次数
  aiCallsUsed     Int      @default(0)  // AI API 已用次数
  aiCallsMax      Int      @default(50)  // AI API 最大次数
  
  // 故事分析结果
  goldenQuote     String?  // 金句
  lingeringMood   String?  // 余韵
  secret          String?  // 秘密
  plotTwist       String?  // 反转
  
  // Relations
  messages        RoomMessage[]
  
  @@index([status])
  @@index([hostId])
  @@index([guestId])
  @@index([expiresAt])
  @@index([createdAt])
}

// 双人创作房间消息
model RoomMessage {
  id              String   @id @default(cuid())
  roomId          String   // 房间 ID
  
  round           Int      // 轮次 (1-10)
  role            String   // 角色 (A/B)
  content         String   // 内容 (最多 100 字)
  
  // AI 相关
  isAI            Boolean  @default(false)
  aiStyle         String?  // "温情" | "冲突" | "留白"
  zhihuMaterials  String?  // JSON 数组，知乎素材引用
  
  timestamp       DateTime @default(now())
  
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  @@index([roomId])
  @@index([round])
  @@index([timestamp])
}
